rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user role from custom claims or request
    // Note: You'll need to set custom claims on Firebase Auth users
    // or verify against Supabase profiles table via backend
    function getUserRole() {
      return request.auth.token.role;
    }
    
    // Published announcements contain public business updates and are read
    // directly by the app (which signs users in through Supabase, not Firebase).
    match /announcements/{announcementId} {
      // The app filters the audience_roles field using the signed-in profile.
      // Firebase Auth is not used for app sessions, so visibility is limited
      // here to published content and clients cannot write announcements.
      allow read: if resource.data.status == 'published';
      allow write: if false;
    }
    
    // Notification reads collection (tracks which user read which notification)
    match /notification_reads/{readId} {
      // Users can only read their own read states
      allow read: if isAuthenticated() 
                  && request.auth.uid == resource.data.user_id;
      
      // Users can only create read states for themselves
      allow create: if isAuthenticated() 
                    && request.auth.uid == request.resource.data.user_id
                    && request.resource.data.keys().hasAll(['user_id', 'notification_id', 'read_at']);
      
      // No updates or deletes allowed
      allow update, delete: if false;
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
