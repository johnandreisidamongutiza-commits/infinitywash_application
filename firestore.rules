rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user role from custom claims or request
    // Note: You'll need to set custom claims on Firebase Auth users
    // or verify against Supabase profiles table via backend
    function getUserRole() {
      return request.auth.token.role;
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Anyone authenticated can read notifications for their role
      allow read: if isAuthenticated() 
                  && getUserRole() in resource.data.audience_roles
                  && resource.data.status == 'published';
      
      // Only admins can create/update/delete notifications
      // This should be done via backend, not directly from client
      allow write: if false;
    }
    
    // Notification reads collection (tracks which user read which notification)
    match /notification_reads/{readId} {
      // Users can only read their own read states
      allow read: if isAuthenticated() 
                  && request.auth.uid == resource.data.user_id;
      
      // Users can only create read states for themselves
      allow create: if isAuthenticated() 
                    && request.auth.uid == request.resource.data.user_id
                    && request.resource.data.keys().hasAll(['user_id', 'notification_id', 'read_at']);
      
      // No updates or deletes allowed
      allow update, delete: if false;
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
