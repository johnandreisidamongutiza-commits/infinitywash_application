<mxfile host="app.diagrams.net">
  <diagram name="Customer Flow" id="customer-flow">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Start -->
        <mxCell id="start" value="Customer Opens App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        
        <!-- Login/Register -->
        <mxCell id="login" value="Login / Register" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="600" y="140" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge1" edge="1" parent="1" source="start" target="login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Main Menu Decision -->
        <mxCell id="menu" value="Choose Action" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="605" y="250" width="150" height="150" as="geometry" />
        </mxCell>
        <mxCell id="edge2" edge="1" parent="1" source="login" target="menu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Option 1: Request Pickup -->
        <mxCell id="request" value="Request Pickup&#xa;(Online Order)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge3" edge="1" parent="1" source="menu" target="request">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label1" value="1. Request Service" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11" vertex="1" connectable="0" parent="edge3">
          <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
            <mxPoint x="-30" y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Upload Photos -->
        <mxCell id="photos" value="Upload Laundry Photos&#xa;&amp; Description" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge4" edge="1" parent="1" source="request" target="photos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Staff Review -->
        <mxCell id="review" value="Wait for&#xa;Staff Review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge5" edge="1" parent="1" source="photos" target="review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Approval Decision -->
        <mxCell id="approval" value="Approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="55" y="780" width="130" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edge6" edge="1" parent="1" source="review" target="approval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Rejected -->
        <mxCell id="rejected" value="View Rejection&#xa;Reason" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="250" y="815" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge7" edge="1" parent="1" source="approval" target="rejected">
