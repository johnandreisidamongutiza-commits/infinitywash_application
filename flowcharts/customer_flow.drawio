        <!-- Payment Method -->
        <mxCell id="paymethod" value="Choose Method" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1">
