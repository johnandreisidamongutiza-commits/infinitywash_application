          </mxGeometry>
        </mxCell>
        
        <!-- Rider Pickup -->
        <mxCell id="pickup" value="Rider Picks Up&#xa;Laundry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="160" height="60" as="geometry" />
