        <!-- Option 2: Track Orders -->
        <mxCell id="track" value="Track Order Status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
