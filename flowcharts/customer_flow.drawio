        <mxCell id="status3" value="Out for Delivery" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="280" y="760" width="160" height="50" as="geometry" />
