rules_version = '2';

// Craft rules based on data in your Firestore database
// Allow users to upload and view chat photo attachments
service firebase.storage {
  match /b/{bucket}/o {
    
    // Chat attachments: Customers, Riders, and Staff
    // Since authentication is handled via Supabase, chat_attachments permits read/write
    match /chat_attachments/{chatId}/{allPaths=**} {
      allow read, write: if true;
    }

    // Default rule: Firebase Auth required for any other paths
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
